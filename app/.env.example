# Create an EU-hosted project at https://eu.posthog.com and copy its
# project token here. Expo public variables are embedded in the app bundle,
# so never use a secret or personal API key.
EXPO_PUBLIC_POSTHOG_API_KEY=phc_your_project_token
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Analytics is disabled in development unless this is explicitly enabled.
EXPO_PUBLIC_POSTHOG_CAPTURE_IN_DEV=false
