{
  "expo": {
    "name": "Air Fryer Converter",
    "slug": "prince-conversions",
    "scheme": "princeconversions",
    "version": "1.5.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brynneprince.airfryerconverter",
      "icon": {
        "light": "./assets/icon-ios.png",
        "dark": "./assets/icon-ios-dark.png",
        "tinted": "./assets/icon-ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.brynneprince.airfryerconverter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FAF5EC"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "locales": {
      "de": { "ios": { "NSUserTrackingUsageDescription": "Erlaube dieser App, deine Daten für personalisierte Werbung zu verwenden." } },
      "fr": { "ios": { "NSUserTrackingUsageDescription": "Autorisez cette app à utiliser vos données pour afficher des publicités personnalisées." } },
      "es": { "ios": { "NSUserTrackingUsageDescription": "Permite que esta app use tus datos para mostrarte anuncios personalizados." } },
      "it": { "ios": { "NSUserTrackingUsageDescription": "Consenti a questa app di usare i tuoi dati per mostrarti annunci personalizzati." } },
      "nl": { "ios": { "NSUserTrackingUsageDescription": "Sta toe dat deze app je gegevens gebruikt om gepersonaliseerde advertenties te tonen." } },
      "pt-BR": { "ios": { "NSUserTrackingUsageDescription": "Permita que este app use seus dados para exibir anúncios personalizados." } }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 144,
          "backgroundColor": "#FAF5EC",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#15110C"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3005788156292964~1665576706",
          "androidAppId": "ca-app-pub-3005788156292964~7822296994",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow this app to use your data to deliver personalized ads."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "de", "fr", "es", "it", "nl", "pt-BR"]
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/done.wav",
            "./assets/sounds/shake.wav"
          ],
          "color": "#C2562E"
        }
      ],
      "expo-widgets"
    ],
    "extra": {
      "eas": {
        "projectId": "ad23e342-6da3-4d83-b69e-5d1ca2af6400"
      },
      "revenueCatIosApiKey": "appl_eWvOgxDYqxmPUybJsFvFneEcXhn",
      "revenueCatAndroidApiKey": "goog_XrzIVwbvfxFxyEimUbIaoQBEQHJ"
    },
    "owner": "brynne98"
  }
}
